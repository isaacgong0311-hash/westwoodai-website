# Copy to .env.local for local dev, or run `vercel env pull .env.local`.
# All optional: without the calendar vars the calendar shows "Schedule coming soon";
# without the leaderboard vars the leaderboard falls back to data/members.json.

# Settings → (club calendar) → Integrate calendar → Calendar ID
GOOGLE_CALENDAR_ID=
# Google Cloud Console → APIs & Services → Credentials → API key,
# restricted to the Google Calendar API
GOOGLE_CALENDAR_API_KEY=

# Leaderboard (README "Leaderboard"): the sheet ID from its URL, and the
# service account's whole JSON key file. Wrap the JSON in single quotes here.
LEADERBOARD_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
